INTEL_MEDIA_SDK_COMMIT=869b60a6c3d7b5e9f7c3b3b914986322dca4bbae
INTEL_MEDIA_SDK_VERSION=23.2.2
FFMPEG_GIT_URL=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_COMMIT=38b88335f99e76ed89ff3c93f877fdefce736c13
FFMPEG_VERSION=8.1.2
INTEL_LEGACY_RUNTIME_FORMAT=2
